rules_version = '2';

// firestore.rules — Build 1.3b
//
// Principio rector, sin excepciones: DENEGAR POR DEFECTO. Cada colección
// declara explícitamente quién puede leer/escribir; cualquier acceso no
// contemplado queda bloqueado por la regla de cierre al final del archivo.
//
// El aislamiento entre casos se resuelve consultando `caseMemberships`
// dentro de la propia regla — nunca confiando en un campo que el cliente
// pueda enviar sin verificar (por ejemplo, nunca confiar en un `caseId`
// del payload sin comprobar que quien escribe tiene membresía activa en
// ESE caso específico).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----

    function isSignedIn() {
      return request.auth != null;
    }

    function activeMembership(caseId) {
      return exists(/databases/$(database)/documents/caseMemberships/$(
        getMembershipId(caseId, request.auth.uid)
      ));
    }

    function getMembershipId(caseId, userId) {
      // El id del documento de membresía no es libre — se exige que el
      // cliente lo nombre como `${caseId}_${userId}` para poder resolverlo
      // en una regla sin una consulta adicional.
      return caseId + '_' + userId;
    }

    function membershipData(caseId) {
      return get(/databases/$(database)/documents/caseMemberships/$(
        getMembershipId(caseId, request.auth.uid)
      )).data;
    }

    function hasRole(caseId, roles) {
      return isSignedIn()
        && activeMembership(caseId)
        && membershipData(caseId).status == 'active'
        && membershipData(caseId).role in roles;
    }

    function canRead(caseId) {
      return hasRole(caseId, ['owner', 'editor', 'viewer']);
    }

    function canWrite(caseId) {
      return hasRole(caseId, ['owner', 'editor']);
    }

    function canManageMembers(caseId) {
      return hasRole(caseId, ['owner']);
    }

    // ---- Casos ----

    match /cases/{caseId} {
      allow read: if canRead(caseId);
      allow write: if canWrite(caseId);
    }

    // ---- Membresías ----
    // El id del documento es "{caseId}_{userId}" — permite resolver
    // pertenencia sin una consulta adicional en las reglas de arriba.

    function isOwnerRole(data) {
      return data.role == 'owner';
    }

    // Modelo de owner único (Build 1.3b — ver docs/adr-018-single-owner-model.md):
    // mientras no exista un caso de uso de transferencia de propiedad, una
    // membresía owner no puede alterarse mediante una escritura normal —
    // es la política vigente del modelo actual, no una imposibilidad
    // estructural. El día que exista `TransferOwnership`, esta función es
    // el único lugar que habrá que revisar junto con esa implementación.
    function preservesOwnerUnderCurrentModel(existing, incoming) {
      return !isOwnerRole(existing) || (isOwnerRole(incoming) && incoming.status == existing.status);
    }

    match /caseMemberships/{membershipId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || canManageMembers(resource.data.caseId));
      // Defecto real corregido: la versión anterior exigía canManageMembers()
      // (tener ya una membresía owner) para crear CUALQUIER membresía —
      // incluida la primera, lo cual es una paradoja imposible de cumplir
      // (nadie puede ser el primer owner porque hace falta ser owner para
      // crearlo). Se separan explícitamente dos casos:
      allow create: if isSignedIn() && (
        // Caso normal: un owner existente invita/crea una membresía para
        // otra persona — nunca puede otorgar el rol owner por esta vía.
        (canManageMembers(request.resource.data.caseId) && !isOwnerRole(request.resource.data))
        ||
        // Caso de arranque: la primera persona que crea un caso se asigna
        // a sí misma como owner — solo si todavía no tiene ninguna
        // membresía en ESE caso específico (bootstrapOwnerMembership).
        // Riesgo residual documentado: caseId es un UUID generado
        // (Identifier.generate()), no adivinable — mismo criterio ya
        // usado para el id de las invitaciones. Endurecer esto más allá
        // exigiría una Cloud Function, fuera de alcance de esta
        // corrección puntual.
        (!activeMembership(request.resource.data.caseId)
          && isOwnerRole(request.resource.data)
          && request.resource.data.userId == request.auth.uid)
      );
      // Nunca se permite que alguien se autoasigne una membresía propia
      // que no sea el arranque descrito arriba — toda membresía posterior
      // nace de aceptar una invitación, gestionada por MembershipService.
      allow update: if isSignedIn()
        && canManageMembers(resource.data.caseId)
        && preservesOwnerUnderCurrentModel(resource.data, request.resource.data);
      allow delete: if false;
    }

    // ---- Gastos ----
    // Build 1.4: expenses/{expenseId} como colección superior, con caseId
    // como campo (decisión D.3, aprobada — mismo criterio que
    // caseMemberships). Campos inmutables protegidos con
    // diff().affectedKeys(): id (implícito, nunca se reescribe el
    // documento con otro id), caseId, createdAt, createdByUserId.

    function immutableExpenseFieldsUnchanged() {
      let protectedKeys = ['caseId', 'createdAt', 'createdByUserId'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys) == false;
    }

    match /expenses/{expenseId} {
      allow read: if canRead(resource.data.caseId);
      allow create: if isSignedIn()
        && canWrite(request.resource.data.caseId)
        && request.resource.data.createdByUserId == request.auth.uid;
      allow update: if isSignedIn()
        && canWrite(resource.data.caseId)
        && immutableExpenseFieldsUnchanged()
        && request.resource.data.updatedByUserId == request.auth.uid;
      // Nunca eliminación física — la anulación es una actualización que
      // establece deletedAt/cancelledByUserId/cancellationReason, nunca un
      // delete real (informe del Build 1.4, sección 9).
      allow delete: if false;
    }

    // ---- Reembolsos ----
    // Build 1.5: reimbursements/{reimbursementId} como colección superior,
    // con caseId como campo — mismo criterio ya aprobado para expenses
    // (decisión D.3 del Build 1.4). El `caseId` que llega en el payload no
    // se cree por sí solo: canWrite() lo verifica contra la membresía real.
    //
    // `expenseId` es inmutable a propósito: mover un reembolso de un gasto
    // a otro alteraría retroactivamente el monto neto de dos gastos a la
    // vez. Si hace falta corregirlo, se anula y se registra de nuevo, lo
    // que deja rastro. Misma lógica que en Reimbursement.update().

    function immutableReimbursementFieldsUnchanged() {
      let protectedKeys = ['caseId', 'expenseId', 'createdAt', 'createdByUserId'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys) == false;
    }

    match /reimbursements/{reimbursementId} {
      allow read: if canRead(resource.data.caseId);
      allow create: if isSignedIn()
        && canWrite(request.resource.data.caseId)
        && request.resource.data.createdByUserId == request.auth.uid;
      allow update: if isSignedIn()
        && canWrite(resource.data.caseId)
        && immutableReimbursementFieldsUnchanged()
        && request.resource.data.updatedByUserId == request.auth.uid;
      // Nunca eliminación física — la anulación es una actualización que
      // establece deletedAt/cancelledByUserId/cancellationReason, igual que
      // en expenses.
      allow delete: if false;
    }

    // ---- Liquidaciones ----
    // Build 1.7. Una liquidación es la foto congelada de un estado de cuenta.
    // `expenseIds`, `periodStart` y `periodEnd` son inmutables: si cambiaran,
    // la foto dejaría de corresponder a lo que las partes acordaron. Corregir
    // se hace anulando y liquidando de nuevo, lo que deja rastro.

    function immutableSettlementFieldsUnchanged() {
      let protectedKeys = ['caseId', 'periodStart', 'periodEnd', 'expenseIds', 'settledAt', 'settledByUserId'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys) == false;
    }

    match /settlements/{settlementId} {
      allow read: if canRead(resource.data.caseId);
      allow create: if isSignedIn()
        && canWrite(request.resource.data.caseId)
        && request.resource.data.settledByUserId == request.auth.uid;
      // La única actualización legítima es la anulación.
      allow update: if isSignedIn()
        && canWrite(resource.data.caseId)
        && immutableSettlementFieldsUnchanged();
      allow delete: if false;
    }

    // ---- Participantes y beneficiarios ----
    // Se agregan en un build de corrección: nunca se sincronizaban, así que
    // un dispositivo nuevo recuperaba el caso sin las personas que lo
    // componen y la aplicación no podía ni pintar la pantalla principal.
    // Sin borrado físico: los beneficiarios se desactivan (isActive), y un
    // participante eliminado dejaría gastos apuntando a nadie.

    match /participants/{participantId} {
      allow read: if canRead(resource.data.caseId);
      allow create: if isSignedIn() && canWrite(request.resource.data.caseId);
      allow update: if isSignedIn()
        && canWrite(resource.data.caseId)
        && request.resource.data.caseId == resource.data.caseId;
      allow delete: if false;
    }

    match /beneficiaries/{beneficiaryId} {
      allow read: if canRead(resource.data.caseId);
      allow create: if isSignedIn() && canWrite(request.resource.data.caseId);
      allow update: if isSignedIn()
        && canWrite(resource.data.caseId)
        && request.resource.data.caseId == resource.data.caseId;
      allow delete: if false;
    }

    // ---- Pagos ----
    // Build 1.8. `caseId`, quién paga y quién recibe son inmutables: cambiar
    // la dirección de un pago ya registrado alteraría el saldo entre las dos
    // partes sin dejar rastro. Corregir se hace anulando y registrando de
    // nuevo. Sin borrado físico: borrar dinero que alguien declaró haber
    // entregado sería la peor forma de perder la confianza.

    function immutablePaymentFieldsUnchanged() {
      let protectedKeys = ['caseId', 'paidByParticipantId', 'receivedByParticipantId', 'createdAt', 'createdByUserId'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys) == false;
    }

    match /payments/{paymentId} {
      allow read: if canRead(resource.data.caseId);
      allow create: if isSignedIn()
        && canWrite(request.resource.data.caseId)
        && request.resource.data.createdByUserId == request.auth.uid;
      allow update: if isSignedIn()
        && canWrite(resource.data.caseId)
        && immutablePaymentFieldsUnchanged();
      allow delete: if false;
    }

    // ---- Invitaciones ----

    match /invitations/{invitationId} {
      allow create: if isSignedIn() && canManageMembers(request.resource.data.caseId);
      // Leer una invitación puntual (para aceptarla) no exige membresía —
      // la validación real de identidad ocurre en MembershipService
      // (coincidencia de correo + hash del token); esta regla solo evita
      // listar invitaciones ajenas por fuerza bruta.
      allow get: if isSignedIn();
      allow list: if false;
      allow update: if isSignedIn()
        && (canManageMembers(resource.data.caseId) || resource.data.email == request.auth.token.email);
      allow delete: if false;
    }

    // ---- Cierre: todo lo no contemplado explícitamente queda denegado ----

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
